 int plat_battery(void)                           /* (a level moves once the reading is 4 past its threshold) */
 {
@@ -61,6 +62,7 @@ int plat_battery(void)                           /* (a level moves once the read
         batt_bars--;
     return batt_bars;
 }
+int plat_battery_raw(void) { return batt_raw; }
 
