 static void midi_in_event(uint32_t pkt)                 /* one USB-MIDI event packet */
 {
     uint32_t cin = pkt & 15u, st = (pkt >> 8) & 0xFFu;
+#ifdef FM1B_MIDI_TAP
+    tap_usb(pkt, fm1_ms);                               /* the monitor's copy, all of it (device/midi_tap.c) */
+#endif
     if (cin >= 4u && cin <= 7u) {
