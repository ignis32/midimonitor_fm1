+/* the USB MIDI host: the app's switch, and a device the script plugs in ("usbhost") */
+static int usbh_want, usbh_ready, usbh_ev;
+void plat_usb_host(int on)
+{
+    if ((on != 0) != usbh_want)
+        usbh_ev = on ? USBH_EV_ON : USBH_EV_OFF;
+    usbh_want = on != 0;
+    if (!on)
+        usbh_ready = 0;
+}
+int plat_usb_host_state(void) { return !usbh_want ? USBH_OFF : usbh_ready ? USBH_READY : USBH_WAITING; }
+int plat_usb_host_event(void)
+{
+    int e = usbh_ev;
+    usbh_ev = USBH_EV_NONE;
+    return e;
+}
 
