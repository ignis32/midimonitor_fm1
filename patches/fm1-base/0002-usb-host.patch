+/* USB MIDI host (FM1B_USB_HOST 1 in the app's app.h; felucca-bsp chip/usb_host.c, from Melodee pull request #75):
+ * the USB-C port as the host of a class compliant USB-MIDI controller, alone or behind a hub with its own power
+ * (nothing drives VBUS: the controller needs power from a hub or an OTG adapter). Its MIDI comes in as USB
+ * (plat_midi_in: channel messages, clock and transport; the MIDI tap: all of it). Never kept: every boot is a
+ * device, so the update paths always work. Full-speed devices only; no MIDI out to the controller. Main loop. */
+enum { USBH_OFF, USBH_WAITING, USBH_READY };   /* a device; a host with no controller yet; a controller playing */
+enum { USBH_EV_NONE, USBH_EV_ON, USBH_EV_OFF, USBH_EV_MIDI, USBH_EV_NOMIDI, USBH_EV_LOW, USBH_EV_LOST };
+void plat_usb_host(int on);             /* 1: the port a host, 0: a device again (the computer's) */
+int plat_usb_host_state(void);          /* USBH_* (USBH_OFF too without FM1B_USB_HOST) */
+int plat_usb_host_event(void);          /* what happened since the last call, once: USBH_EV_* (NOMIDI: a device
+                                         * with no USB-MIDI interface, LOW: a low-speed one, LOST: gone) */
+
 /* the keys' velocity and pressure (an app with APP_KEY_SENSE): on, the scan reads the keys on the analog rows and
  * hands each reading to the app (app_key_sample, app_key_probe); off by default */
 void plat_sense(int on);
